# Local development only. Generate unique hexadecimal values as documented in README.md.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
OPENROUTER_API_KEY=
EODHD_API_KEY=

# Approver token for the local API. At least 16 characters. Generate one with: openssl rand -hex 16
APPROVAL_TOKEN=

# Postgres for the local API and worker. Bun expands ${POSTGRES_PASSWORD} from this file. URL-encode the password if it has special characters.
DATABASE_URL=postgresql://foresight:${POSTGRES_PASSWORD}@127.0.0.1:5432/foresight
